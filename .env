###> Security ###
# SHA-256 hash of the plaintext API key clients must send as X-Api-Key.
# Default below corresponds to plaintext key: "local-dev-api-key"
# Generate your own with: echo -n "your-key" | sha256sum
API_KEY_HASH=2bcd99491790f5324dd084241b713b576a92b12c497f3b553230d49cc72e15c2
###< Security ###
